    "@remotion/media": "^4.0.522",
    "@remotion/media-utils": "^4.0.522",
    "@remotion/motion-blur": "^4.0.522",
    "@remotion/noise": "^4.0.522",
    "@remotion/paths": "^4.0.522",
    "@remotion/player": "^4.0.522",
    "@remotion/rough-notation": "^4.0.522",
    "@remotion/shapes": "^4.0.522",
    "@remotion/three": "^4.0.522",
    "@remotion/transitions": "^4.0.522",
    "@types/d3-array": "^3.2.2",
    "@types/d3-chord": "^3.0.6",
    "@types/d3-force": "^3.0.10",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-polygon": "^3.0.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/three": "^0.185.4",
    "d3-array": "^3.2.4",
    "d3-chord": "^3.0.1",
    "d3-delaunay": "^6.0.4",
    "d3-force": "^3.0.0",
    "d3-geo": "^3.1.1",
    "d3-hierarchy": "^3.1.2",
    "d3-path": "^3.1.0",
    "d3-polygon": "^3.0.1",
    "d3-sankey": "^0.12.3",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "edododraw": "^0.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "^4.0.522",
    "three": "^0.185.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@remotion/bundler": "^4.0.522",
